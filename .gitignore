# Runtime state for the itzg/docker-minecraft-server container: world saves,
# downloaded server jar/plugins/libraries, cache, logs, and player data
# (whitelist/ops/bans). Regenerated on start or managed in-game — not tracked.
data/

# Telegram bot secrets and runtime state
telegram-bot/.env
telegram-bot/minecraft-telegram-bot.service
telegram-bot/state.json
telegram-bot/bot.log
telegram-bot/__pycache__/

# World backups and the RCON password shared by minecraft and backups
backups/
rcon_password

# Wanderer bot: Microsoft auth token cache, secrets, and runtime state
wanderer-bot/node_modules/
wanderer-bot/.env
wanderer-bot/.auth-cache/
wanderer-bot/promises.json
wanderer-bot/directive.json
wanderer-bot/wanderer-bot.pid
wanderer-bot/bot.log
wanderer-bot/first-run.out

# Custom plugins: Maven build output
custom-plugins/*/target/
