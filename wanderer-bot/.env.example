# Copy to .env and fill in. .env is gitignored.

# The whitelisted Minecraft Java account the bot logs in as (its email or
# Xbox/Microsoft username -- whatever you'd type into the Minecraft launcher).
MC_USERNAME=

SERVER_HOST=localhost
SERVER_PORT=25565

# Used by watch.sh: the in-game username to watch for. The bot is started
# when they're online and stopped when they leave.
TARGET_PLAYER=

# Optional: who the bot is secretly devoted to (helps them readily, hides it
# from everyone else). Defaults to TARGET_PLAYER if unset -- set this
# separately only if you want those to be different people, or unset both
# for no favorite at all.
FAVORITE_PLAYER=

# How often it polls RCON to check (watch.sh only -- cheap, no LLM involved).
POLL_SECONDS=20

# Optional hard session length in minutes (0/unset = none -- watch.sh or
# Ctrl-C/SIGTERM ends the session instead). Mostly useful for manual runs.
SESSION_MINUTES=0

# How often it acts on its own (say something/react) when nobody's talking to it.
IDLE_TICK_MINUTES=3
