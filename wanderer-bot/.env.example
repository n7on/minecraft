# Copy to .env and fill in. .env is gitignored.

# The whitelisted Minecraft Java account the bot logs in as (its email or
# Xbox/Microsoft username -- whatever you'd type into the Minecraft launcher).
MC_USERNAME=

SERVER_HOST=localhost
SERVER_PORT=25565

# How long one summoned session lasts before it says farewell and leaves.
SESSION_MINUTES=30

# How often it acts on its own (wander/say something) when nobody's talking to it.
IDLE_TICK_MINUTES=3
