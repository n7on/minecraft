# Copy this file to .env and fill in real values. .env is gitignored.

# Token from @BotFather on Telegram
BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed full control of the server.
# Get yours by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=

# Comma-separated Telegram numeric user IDs allowed read-only/info access
# (no shell, no edits -- can't change anything, just ask questions).
READONLY_USER_IDS=

# Absolute path to the minecraft project (where docker-compose.yml lives).
PROJECT_DIR=/path/to/minecraft

# Hour (0-23, host's local timezone) each chat's conversation resets fresh.
# Keeps context (and cost) from growing unbounded across days.
RESET_HOUR=3
