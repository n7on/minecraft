[Unit]
Description=Telegram bot for controlling the Minecraft server (via Claude Code)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/minecraft/telegram-bot
EnvironmentFile=/path/to/minecraft/telegram-bot/.env
ExecStart=/usr/bin/python3 /path/to/minecraft/telegram-bot/bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
